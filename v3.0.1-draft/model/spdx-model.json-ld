  {
    "@id": "https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm/blake2b512",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.0.1/terms/Core/HashAlgorithm"
