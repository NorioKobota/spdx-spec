        "@value": "The `from` Build element generates each `to` Element as an output, during a LifecycleScopeType period."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasOutputs"
      }
    ]
  },
